[Unit]
Description=KeepFit HTTPS proxy
After=network-online.target keepfit-model.service
Wants=network-online.target
[Service]
User=keepfit-proxy
Group=keepfit-proxy
ExecStart=/usr/bin/caddy run --config /etc/keepfit/Caddyfile --adapter caddyfile
Environment=HOME=/var/lib/keepfit-proxy
Environment=XDG_DATA_HOME=/var/lib/keepfit-proxy
StateDirectory=keepfit-proxy
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=128M
TasksMax=64
[Install]
WantedBy=multi-user.target
